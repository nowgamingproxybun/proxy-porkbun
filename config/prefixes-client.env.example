# Per-client origin hostname prefixes (one label per line).
# __CLIENT__ is replaced with each client name from /etc/proxies/clients/<name>.env
# Resulting hostname: <prefix>.<current-domain>
# Each service is listed with and without -bgsp for legacy clients.

__CLIENT__-gs-prod
__CLIENT__-gs-prod-bgsp
__CLIENT__-gs-demo-prod
__CLIENT__-gs-demo-prod-bgsp
__CLIENT__-lobby-prod
__CLIENT__-lobby-prod-bgsp
__CLIENT__-api-prod
__CLIENT__-api-prod-bgsp
__CLIENT__-gc-prod
__CLIENT__-gc-prod-bgsp
