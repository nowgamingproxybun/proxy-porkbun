# Legacy WHOIS contact for --domain-source internetbs only.
# Porkbun (default) uses the account contact on porkbun.com — this file is unused.
# Copy to /etc/proxies/registrant.env before first rotation.
#
# Privacy: registrations use privateWhois=FULL, so these contacts are NOT
# shown in public WHOIS. The registrar API still requires contact fields —
# they cannot be omitted. Street and City must be different values.
#
# Phone must be InternetBS format: +CC.NUMBER (e.g. +1.5555555555)
#
# Email: REGISTRANT_EMAIL is overwritten at runtime and on install with
# CERTBOT_EMAIL from credentials.env (--email). Use a real mailbox you can
# access — InternetBS sends domain verification there, and Let's Encrypt uses
# it for the ACME account / expiry notices.

REGISTRANT_FIRSTNAME="Alex"
REGISTRANT_LASTNAME="Morgan"
REGISTRANT_EMAIL="unused@example.com"
REGISTRANT_PHONE="+1.5555550100"
REGISTRANT_STREET="100 Example Avenue"
REGISTRANT_CITY="Wilmington"
REGISTRANT_COUNTRYCODE="US"
REGISTRANT_POSTALCODE="19801"
REGISTRANT_ORGANIZATION=""
